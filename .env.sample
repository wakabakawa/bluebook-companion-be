# Copy to .env (gitignored) and fill in DB_URL for seed:catalog/seed:answer-key against a
# remote project. Defaults to the local stack if unset.
#
# Use the Direct connection string if it connects (plain `postgres` user); if it times out
# (its host is IPv6-only), use the Session pooler string instead (`postgres.<project-ref>`
# user). Both from Dashboard -> Project Settings -> Database -> Connect.
DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
